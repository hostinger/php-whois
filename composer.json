{
    "name": "hostinger/php-whois",
    "description": "PHP WHOIS provides parsed and raw WHOIS lookup of domains and ASN routes.",
    "keywords": [
        "php",
        "whois",
        "query",
        "tld",
        "domain",
        "lookup",
        "info",
        "asn",
        "routes",
        "parser"
    ],
    "type": "library",
    "license": "MIT",
    "require" : {
        "php" : ">=8.3",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "symfony/polyfill-intl-idn": "^1.27"
    },
    "require-dev" : {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Iodev\\": "src/Iodev/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "": [ "tests/" ]
        }
    },
    "scripts": {
        "test": [
            "phpunit --bootstrap tests/bootstrap.php tests"
        ]
    }
}
